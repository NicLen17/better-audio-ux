<Window x:Class="BetterAudio.UI.Flyout.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BetterAudio.UI.Flyout"
        Title="Better Audio" Width="408" Height="366"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI" Foreground="#EEF8F5"
        PreviewKeyDown="Window_KeyDown" Deactivated="Window_Deactivated" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleIf"/>
        <Style x:Key="FooterGroupButton" TargetType="Button">
            <Setter Property="Foreground" Value="#142C28"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="9,6,3,6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="Transparent" CornerRadius="0" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#25142C28"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#25142C28"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FooterIconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C5F6E4"/><Setter Property="Background" Value="#172B30"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SpatialEnabled}" Value="True"/><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Spatial"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="#BFF4DE"/><Setter Property="Foreground" Value="#172B30"/></MultiDataTrigger></Style.Triggers>
        </Style>        <Style x:Key="FooterCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#142C28"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Section" Background="Transparent" Padding="6,0"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Section" Property="Background" Value="#2D5C4E"/><Setter Property="Foreground" Value="#E3FFF3"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Section" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Section" Property="BorderBrush" Value="#183C30"/><Setter TargetName="Section" Property="BorderThickness" Value="1"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GroupButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C1D3D0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="Transparent" CornerRadius="19,0,0,19" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#364E4D"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#364E4D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="16"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent" Margin="5,3"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Grip" Background="#628C7D" CornerRadius="3"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#96E6C9"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#BAF4DC"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="#C1D3D0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="15,10"/><Setter Property="Background" Value="#26353B"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Capsule" CornerRadius="20" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Capsule" Property="Background" Value="#364E4D"/><Setter Property="Foreground" Value="#EBFFF8"/>
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Capsule" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.14"/>
                            <DoubleAnimation Storyboard.TargetName="Capsule" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.14"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Capsule" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/>
                            <DoubleAnimation Storyboard.TargetName="Capsule" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Capsule" Property="Background" Value="#3B5D55"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Capsule" Property="Opacity" Value="0.6"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Capsule" Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="#94B9AE"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="Transparent" Padding="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#E4FFF4"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#E4FFF4"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="local:AnimatedVolumeSlider">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:AnimatedVolumeSlider">
                <Grid Height="28" Background="Transparent">
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding DisplayValue}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#96E6C9" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="13" Height="13"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#C2F9E4" Stroke="#416E60" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#3C5054" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#849F99"/><Setter Property="FontSize" Value="10"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                    <Border x:Name="CheckSurface" Width="13" Height="13" CornerRadius="4" BorderBrush="#66827B" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="Tick" Text="✓" FontSize="10" FontWeight="SemiBold" Foreground="#182F27" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ContentPresenter VerticalAlignment="Center"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#99E7C9"/><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#99E7C9"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#D1E9DF"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#EBFFF6"/><Setter Property="Foreground" Value="#EBFFF6"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource IconButton}"><Setter Property="Foreground" Value="#142C28"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#28483D"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="#28483D"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Border x:Name="HudSurface" Margin="14" CornerRadius="44,44,16,16" BorderBrush="#8596E6C9" BorderThickness="1" RenderTransformOrigin="0.5,1">
        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EB18282C" Offset="0"/><GradientStop Color="#F0111B23" Offset="1"/></LinearGradientBrush></Border.Background>
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.22" Color="#000000"/></Border.Effect>
        <Border.RenderTransform><TransformGroup><ScaleTransform x:Name="RevealScale"/><TranslateTransform x:Name="RevealOffset"/></TransformGroup></Border.RenderTransform>
        <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border CornerRadius="43,43,0,0" Background="#96E6C9"><Grid Margin="17,4">
            <Button x:Name="PinButton" Style="{StaticResource HeaderButton}" Foreground="#142C28" HorizontalAlignment="Left" Click="Pin_Click" ToolTip="Fijar panel: mantener abierto al usar otra aplicación" AutomationProperties.Name="Fijar o desfijar panel"><Viewbox Width="18" Height="18"><Path x:Name="PinShape" Data="M 6,2 L 18,2 L 16,5 L 16,11 L 20,15 L 13,15 L 12,23 L 11,15 L 4,15 L 8,11 L 8,5 Z" Stroke="#142C28" StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/></Viewbox></Button>
            <TextBlock Text="Better Audio UX" Foreground="#142C28" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,24,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource HeaderButton}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE713;" FontSize="13" Click="AudioSettings_Click" ToolTip="Configuración general de audio" AutomationProperties.Name="Abrir configuración general de audio" Margin="0,0,3,0"/>
                <Button Width="28" Height="28" Cursor="Hand" Click="Close_Click" ToolTip="Cerrar · Esc" AutomationProperties.Name="Cerrar overlay"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="CloseCircle" Background="#172B30" CornerRadius="14"><TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#BFF4DE" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseCircle" Property="Background" Value="#315248"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CloseCircle" Property="Background" Value="#315248"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
            </StackPanel>
        </Grid></Border>
        <Grid x:Name="OutputView" Grid.Row="1" Margin="12,8,12,6">
            <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsMixerOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="148"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="CarouselViewport" PreviewMouseWheel="Carousel_Wheel" ClipToBounds="True">
                <Ellipse Width="128" Height="78" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" Fill="#255B4A" Opacity="0.35" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="26"/></Ellipse.Effect></Ellipse>
                <ItemsControl x:Name="Carousel" ItemsSource="{Binding Devices}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:ArcCarouselPanel SelectedIndex="{Binding SelectedIndex}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Width="96" Height="100" Click="Device_Click" Cursor="Hand" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}" AutomationProperties.ItemStatus="{Binding Status}" IsTabStop="{Binding IsPreview}">
                            <Button.Template><ControlTemplate TargetType="Button">
                                <Grid x:Name="DeviceSurface" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                                    <Ellipse Width="82" Height="82" Stroke="#8CA6D9C8" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#354B6D61"/><GradientStop Color="#202A403C" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse x:Name="Light" Width="78" Height="78" Fill="#304F47" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.Effect><BlurEffect Radius="15"/></Ellipse.Effect></Ellipse>
                                    <TextBlock x:Name="DeviceGlyph" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="52" Foreground="#B5E8D7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-12" Background="#80101C20" CornerRadius="8" Padding="6,2">
                                        <TextBlock Text="{Binding Status}" FontSize="9" FontWeight="SemiBold" Foreground="#C7F8E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Ellipse Width="5" Height="5" Fill="#B2F5D8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" Visibility="{Binding IsDefault, Converter={StaticResource VisibleIf}}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsPreview}" Value="True"><Setter TargetName="Light" Property="Opacity" Value="0.6"/><Setter TargetName="DeviceGlyph" Property="Foreground" Value="#C7F8E7"/><Setter TargetName="DeviceGlyph" Property="Effect"><Setter.Value><DropShadowEffect Color="#9CE8CC" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/></Setter.Value></Setter></DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DeviceSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.05" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="DeviceSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.05" Duration="0:0:0.14"/>
                                    </Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DeviceSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="DeviceSurface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/>
                                    </Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Light" Property="Opacity" Value="0.9"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Button.Template>
                        </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource IconButton}" Focusable="False" Content="‹" FontSize="23" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Previous_Click" IsEnabled="{Binding HasDevices}" ToolTip="Anterior · ←" AutomationProperties.Name="Dispositivo anterior"/>
                <Button Style="{StaticResource IconButton}" Focusable="False" Content="›" FontSize="23" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Next_Click" IsEnabled="{Binding HasDevices}" ToolTip="Siguiente · →" AutomationProperties.Name="Dispositivo siguiente"/>
                <Button Content="Buscar salidas" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Retry_Click">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Pill}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDevices}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="20,0"><TextBlock Text="{Binding SelectedName}" ToolTip="{Binding SelectedDevice.Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="15" FontWeight="SemiBold" MaxHeight="39" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid Grid.Row="2" Margin="14,0" PreviewMouseWheel="Volume_Wheel" IsEnabled="{Binding CanInteract}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Content="{Binding VolumeGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Click="Mute_Click" ToolTip="{Binding MuteLabel}" AutomationProperties.Name="{Binding MuteLabel}"/>
                <local:AnimatedVolumeSlider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Volumen del dispositivo" ToolTip="↑ ↓ o rueda · Shift para pasos de 10%"/>
                <TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}" FontSize="11" Foreground="#B5D5C9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding Message}" Foreground="#EBC9AA" Background="#ED17242B" FontSize="9" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" MaxWidth="330" Margin="0,2,0,0" Visibility="{Binding HasMessage, Converter={StaticResource VisibleIf}}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
        <Border Grid.Row="2" CornerRadius="0" Background="#96E6C9" Height="44">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsMixerOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource FooterGroupButton}" Click="Mixer_Click" AutomationProperties.Name="Abrir mezclador integrado" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="&#xE9E9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Mezclador" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Grid.Column="1" Style="{StaticResource FooterIconButton}" Click="MixerSettings_Click" Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" ToolTip="Mezclador de Windows" AutomationProperties.Name="Abrir configuración del mezclador en Windows"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Margin="0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding SpatialEnabled}" Value="True"><Setter Property="Background" Value="#2D5C4E"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource FooterCheckBox}" Content="Espacial" HorizontalContentAlignment="Right" Margin="0" IsChecked="{Binding SpatialEnabled, Mode=OneWay}" IsEnabled="{Binding CanToggleSpatial}" Click="SpatialToggle_Click" ToolTip="{Binding SpatialHint}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Activar o desactivar sonido espacial"/>
                        <Button Grid.Column="1" Style="{StaticResource FooterIconButton}" Tag="Spatial" Click="Spatial_Click" IsEnabled="{Binding HasDevices}" Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" ToolTip="Proveedores y propiedades de sonido espacial en Windows" AutomationProperties.Name="Configurar sonido espacial en Windows"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" Width="1" Height="24" Background="#70142C28" HorizontalAlignment="Left" IsHitTestVisible="False" Panel.ZIndex="3"/>
                <Border Grid.Column="2" Width="1" Height="24" Background="#70142C28" HorizontalAlignment="Left" IsHitTestVisible="False" Panel.ZIndex="3"/>
                <Border Grid.Column="2" Background="Transparent" Margin="0">
                    <CheckBox Style="{StaticResource FooterCheckBox}" Content="Fijar al navegar" Margin="0" IsChecked="{Binding AutoSwitchOnNavigation, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip="Cambia la salida automáticamente al recorrer el arco. Desmarcá para elegir con Enter o clic." AutomationProperties.Name="Fijar salida al navegar"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="3" Height="16" CornerRadius="0,0,15,15" Background="#96E6C9" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsMixerOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
        <Grid x:Name="MixerView" Grid.Row="1" Grid.RowSpan="2" Margin="20,8,20,18">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMixerOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="26"/><RowDefinition Height="42"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Left" Click="Back_Click" ToolTip="Volver a dispositivos · Esc" AutomationProperties.Name="Volver a dispositivos"/>
                <TextBlock Text="Mezclador" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Right" Click="MixerSettings_Click" ToolTip="Mezclador de Windows" AutomationProperties.Name="Abrir configuración del mezclador en Windows"/>
            </Grid>
            <Border Grid.Row="1" Grid.RowSpan="2" Background="#35446559" BorderBrush="#568B7768" BorderThickness="0,0,0,1" CornerRadius="14" Margin="0,0,0,-2"/><TextBlock Grid.Row="1" Text="{Binding SelectedName, StringFormat={}{0} (general)}" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="11" Foreground="#91B2A7" VerticalAlignment="Center"/>
            <Grid Grid.Row="2" Margin="3,0" PreviewMouseWheel="Volume_Wheel" IsEnabled="{Binding CanInteract}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource IconButton}" Content="{Binding VolumeGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Click="Mute_Click" ToolTip="{Binding MuteLabel}" AutomationProperties.Name="{Binding MuteLabel}"/>
                <local:AnimatedVolumeSlider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="Volumen principal de la salida"/>
                <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}" FontSize="11" Foreground="#B5D5C9" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,13,0,2" ClipToBounds="True">
                <ScrollViewer x:Name="MixerList" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PreviewMouseWheel="MixerList_Wheel" Padding="0,0,7,0">
                    <ItemsControl x:Name="MixerSessions" ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border CornerRadius="16" Background="#263B4D46" Margin="0,0,0,8" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="28"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#A8C9BD" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Grid.Column="0" Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Center"/><TextBlock Grid.ColumnSpan="3" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Name}" VerticalAlignment="Center" Margin="26,0,4,0"/>
                                    <Button Grid.Row="1" Style="{StaticResource IconButton}" Content="{Binding MuteGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Click="SessionMute_Click" ToolTip="{Binding MuteLabel}" AutomationProperties.Name="{Binding MuteLabel}"/>
                                    <local:AnimatedVolumeSlider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsMoveToPointEnabled="True" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Volumen de {0}}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Volume, StringFormat={}{0}%}" FontSize="10" Foreground="#A8C9BD" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding MixerEmptyText}" FontSize="12" Foreground="#91B2A7" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="12">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSessions}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock Grid.Row="4" Text="{Binding Message}" Foreground="#EBC9AA" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="330" Visibility="{Binding HasMessage, Converter={StaticResource VisibleIf}}" AutomationProperties.LiveSetting="Polite"/>
        </Grid>
        </Grid>
    </Border>
</Window>
